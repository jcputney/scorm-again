        {
          "method": "SetValue",
          "expectedReturn": "false",
          "expectedErrorCode": "404",
          "element": "cmi.comments_from_lms.0.timestamp",
          "value": "bad"
        },
        {
          "method": "GetValue",
          "expectedReturn": "0",
          "expectedErrorCode": "0",
          "element": "cmi.comments_from_lms._count"
        },
        {
          "method": "SetValue",
          "expectedReturn": "false",
          "expectedErrorCode": "406",
          "element": "cmi.comments_from_learner.0.timestamp",
          "value": "bad"
        },
        {
          "method": "GetValue",
          "expectedReturn": "0",
          "expectedErrorCode": "0",
          "element": "cmi.comments_from_learner._count"
        }
